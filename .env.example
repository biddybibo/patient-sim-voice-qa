# LiveKit Cloud project (Settings -> API keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Telephony: LiveKit outbound SIP trunk ID (lk sip outbound list) and the one caller number, E.164
SIP_OUTBOUND_TRUNK_ID=
CALLER_ID_E164=

# The only number the bot will ever dial (also hard-coded in src/guard.py)
TARGET_NUMBER=+18054398008

# Pipeline providers
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
CARTESIA_API_KEY=

# Recording storage for LiveKit Egress (S3 or Cloudflare R2) — used from Phase 2
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Phase 1 placeholder patient (use the details from your Athena test account)
PATIENT_NAME=
PATIENT_DOB=
